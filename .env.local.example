# Kopieer dit bestand naar ".env.local" en vul de echte waarden in.
# ".env.local" wordt nooit gecommit (staat in .gitignore).

# API key van Resend (https://resend.com) - nodig om het contactformulier
# en de boekingsaanvragen per e-mail te kunnen versturen.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# E-mailadres waar nieuwe aanvragen (vending + apartments) naartoe gestuurd worden.
CONTACT_TO_EMAIL=info@marjanivending.nl

# Afzenderadres voor uitgaande mail. Moet een geverifieerd domein zijn in Resend
# (of gebruik voorlopig "onboarding@resend.dev" tijdens het testen).
CONTACT_FROM_EMAIL=Marjani Website <onboarding@resend.dev>

# Onderstaande waarden zijn publiek (NEXT_PUBLIC_) en worden gebruikt voor de
# WhatsApp- en belknoppen op de site.
NEXT_PUBLIC_PHONE_NUMBER=+31612345678
NEXT_PUBLIC_WHATSAPP_NUMBER=31612345678
